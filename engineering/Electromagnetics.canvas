{
	"nodes":[
		{
			"id":"20475392f008a131",
			"type":"text",
			"text":"Types of Charge",
			"styleAttributes":{},
			"x":180,
			"y":-240,
			"width":240,
			"height":80
		},
		{
			"id":"abf0e45514274857",
			"type":"text",
			"text":"Negative Charge",
			"styleAttributes":{},
			"x":540,
			"y":-360,
			"width":260,
			"height":60
		},
		{
			"id":"e1ebd7b10a5b64fb",
			"type":"text",
			"text":"Positive Charge",
			"styleAttributes":{},
			"x":540,
			"y":-160,
			"width":260,
			"height":60
		},
		{
			"id":"7b12c7b4bbf6c131",
			"type":"text",
			"text":"==Electric Charge== is a basic property of matter that causes subatomic particles to experience a force when placed in an electromagnetic field.",
			"styleAttributes":{},
			"x":-420,
			"y":-200,
			"width":380,
			"height":240
		},
		{
			"id":"af4ba51e8a2a9d48",
			"type":"text",
			"text":"Properties of Charge",
			"styleAttributes":{},
			"x":170,
			"y":260,
			"width":260,
			"height":60
		},
		{
			"id":"fe950b9e623c28b0",
			"type":"text",
			"text":"Charge is quantized.",
			"styleAttributes":{},
			"x":600,
			"y":240,
			"width":260,
			"height":60
		},
		{"id":"cb008f77cfeb2af3","type":"file","file":"attachments/EF_positive_charge.svg","x":1220,"y":2220,"width":400,"height":400},
		{"id":"36261970f8eaa98f","type":"file","file":"attachments/EF_negative_charge.svg","x":1660,"y":1800,"width":400,"height":400},
		{
			"id":"12796cb50fb09bd2",
			"type":"text",
			"text":"Charge can neither be created nor destroyed; it can only be transferred from place to place, from one object to another.",
			"styleAttributes":{},
			"x":1160,
			"y":560,
			"width":510,
			"height":120
		},
		{
			"id":"1217f94900cf2ebb",
			"type":"text",
			"text":"Law of Conservation of Charge",
			"styleAttributes":{},
			"x":600,
			"y":580,
			"width":420,
			"height":80
		},
		{
			"id":"c401bc214a8e93ec",
			"type":"text",
			"text":"If two objects that have equal and opposite charges are physically close to each other, then the forces they apply on some other charged object cancel, for a net force of zero.",
			"styleAttributes":{},
			"x":1160,
			"y":720,
			"width":510,
			"height":160
		},
		{
			"id":"13254e8293498b51",
			"type":"text",
			"text":"The smallest charge is $e \\equiv 1.602 \\times 10^{-19} \\,\\text{C}$.",
			"styleAttributes":{},
			"x":1160,
			"y":170,
			"width":420,
			"height":100
		},
		{
			"id":"f8e1d274febf81cb",
			"type":"text",
			"text":"The magnitude of the charge is independent of the type.",
			"styleAttributes":{},
			"x":600,
			"y":400,
			"width":520,
			"height":60
		},
		{
			"id":"2b76c31c1e63b8ef",
			"type":"text",
			"text":"Charge is a scalar quantity, meaning it has magnitude but no direction. The positive/negative indication only refers to algebraic polarity - they are opposite states that can cancel each other out to equal zero.",
			"styleAttributes":{},
			"x":1340,
			"y":320,
			"width":480,
			"height":180
		},
		{
			"id":"17e8aced77633015",
			"type":"text",
			"text":"==Electric Field== is an invisible region surrounding a charged particle or object where other electric charges experience a non-contact force.",
			"styleAttributes":{},
			"x":170,
			"y":980,
			"width":490,
			"height":120
		},
		{
			"id":"84bd6fa0ef41063c",
			"type":"text",
			"text":"The electric field $E$ is defined mathematically as the electric force $F$ exerted on a small, positive test charge $q$ divided by the magnitude of that charge.",
			"styleAttributes":{},
			"x":780,
			"y":980,
			"width":415,
			"height":160
		},
		{
			"id":"bfb2ae912fca2c6a",
			"type":"text",
			"text":"$E = \\frac{F}{q}$",
			"styleAttributes":{},
			"x":1300,
			"y":1030,
			"width":260,
			"height":60
		},
		{"id":"affb20b9b6e2df5f","type":"file","file":"attachments/electric_field_of_dipole.svg","x":1100,"y":1850,"width":400,"height":300},
		{
			"id":"7ae7aeffe501e63c",
			"type":"text",
			"text":"Electrostatic Repulsion",
			"styleAttributes":{},
			"x":40,
			"y":1290,
			"width":260,
			"height":60
		},
		{
			"id":"418dd8da8350ec78",
			"type":"text",
			"text":"Electrostatic Attraction",
			"styleAttributes":{},
			"x":40,
			"y":1470,
			"width":260,
			"height":60
		},
		{
			"id":"35a903218240f8a0",
			"type":"text",
			"text":"==Electric Force== is the attractive or repulsive push and pull that exists between any two charged particles or objects.",
			"styleAttributes":{},
			"x":-350,
			"y":1370,
			"width":260,
			"height":220
		},
		{
			"id":"65ab50771e2ed9e4",
			"type":"text",
			"text":"Unit of Measurement",
			"styleAttributes":{},
			"x":175,
			"y":8,
			"width":245,
			"height":65
		},
		{
			"id":"99e0671db9687d73",
			"type":"text",
			"text":"Coulombs $C$",
			"styleAttributes":{},
			"x":600,
			"y":13,
			"width":210,
			"height":60
		},
		{
			"id":"81a849551b7830f5",
			"type":"text",
			"text":"Newtons per Coulomb $N/C$",
			"styleAttributes":{},
			"x":1370,
			"y":1200,
			"width":320,
			"height":60
		},
		{
			"id":"6d7604ebf9dbfd6b",
			"type":"text",
			"text":"Volts per Meter $V/m$",
			"styleAttributes":{},
			"x":1370,
			"y":1320,
			"width":260,
			"height":60
		},
		{
			"id":"3d550ec7e657e6e0",
			"type":"text",
			"text":"Unit of Measurement",
			"styleAttributes":{},
			"x":800,
			"y":1260,
			"width":420,
			"height":60
		},
		{
			"id":"3ce8dda98aa2538e",
			"type":"text",
			"text":"==Electrical Conductivity== is a material's intrinsic property to conduct an electric current.",
			"styleAttributes":{},
			"x":30,
			"y":-1060,
			"width":460,
			"height":90
		},
		{
			"id":"5022d859808c225a",
			"type":"text",
			"text":"Commonly represented as sigma $\\sigma$.",
			"styleAttributes":{},
			"x":670,
			"y":-1030,
			"width":340,
			"height":60
		},
		{
			"id":"f031b6825ba0b607",
			"type":"text",
			"text":"Conduction electrons can be thought of as physical vehicles that carry the electric charge",
			"styleAttributes":{},
			"x":100,
			"y":-700,
			"width":320,
			"height":140
		},
		{
			"id":"c3e9d7497076e16a",
			"type":"text",
			"text":"==Electrical Resistivity== is a material's intrinsic property to oppose an electric current.",
			"styleAttributes":{},
			"x":30,
			"y":-1320,
			"width":460,
			"height":100
		},
		{
			"id":"3c34323da40e6145",
			"type":"text",
			"text":"Commonly represented as rho $\\rho$.",
			"styleAttributes":{},
			"x":670,
			"y":-1300,
			"width":340,
			"height":60
		},
		{
			"id":"8fe20b8b53734418",
			"type":"text",
			"text":"==Conduction Electrons== are free or delocalized electrons within a solid material that can move easily and carry an electric current.",
			"styleAttributes":{},
			"x":-610,
			"y":-1015,
			"width":380,
			"height":160
		},
		{
			"id":"fe8e161093bc0633",
			"type":"text",
			"text":"Ohm-meter $\\ohm \\cdot m$",
			"styleAttributes":{},
			"x":1040,
			"y":-1560,
			"width":260,
			"height":60
		},
		{
			"id":"cb9e1df0e7fbcc60",
			"type":"text",
			"text":"Unit of Measurement",
			"styleAttributes":{},
			"x":680,
			"y":-1560,
			"width":260,
			"height":60
		},
		{
			"id":"0f5cd398a807c979",
			"type":"text",
			"text":"$$\n\\rho = R \\cdot \\frac{A}{L}\n$$\n\nwhere:\n- R = electrical resistance in ohms\n- A = cross-sectional area in square meters\n- L = length of the material in meters",
			"styleAttributes":{},
			"x":580,
			"y":-2280,
			"width":390,
			"height":300
		},
		{
			"id":"1edff7e5c97bef1e",
			"type":"text",
			"text":"Formula for a uniform conductor",
			"styleAttributes":{},
			"x":-95,
			"y":-2080,
			"width":370,
			"height":80
		},
		{
			"id":"6498f3d412ef4d34",
			"type":"text",
			"text":"$$\n\\rho = \\frac{E}{J}\n$$\n\nwhere:\n- E = electric field\n- J = current density",
			"styleAttributes":{},
			"x":600,
			"y":-1890,
			"width":260,
			"height":240
		},
		{
			"id":"01cd9bb1a7b36d91",
			"type":"text",
			"text":"Microscopic formula",
			"styleAttributes":{},
			"x":15,
			"y":-1800,
			"width":260,
			"height":60
		},
		{
			"id":"334ec36ab747821d",
			"type":"text",
			"text":"$$\n\\sigma = \\frac{1}{\\rho}\n$$",
			"styleAttributes":{},
			"x":1140,
			"y":-1220,
			"width":240,
			"height":130
		},
		{
			"id":"dbfa2967838af430",
			"type":"text",
			"text":"Conductivity can be thought of as a measure of how easily the conduction electrons move through a material.",
			"styleAttributes":{},
			"x":640,
			"y":-710,
			"width":340,
			"height":160
		},
		{
			"id":"1c17c6751639d046",
			"type":"text",
			"text":"Unit of Measurement",
			"styleAttributes":{},
			"x":730,
			"y":-860,
			"width":260,
			"height":60
		},
		{
			"id":"8999aa1ccdb5bd5a",
			"type":"text",
			"text":"(SI unit) Siemens per Meter $S/m$",
			"styleAttributes":{},
			"x":1120,
			"y":-900,
			"width":360,
			"height":70
		},
		{
			"id":"c33f7d91fee0e588",
			"type":"text",
			"text":"$$\n\\sigma = \\frac{J}{E}\n$$",
			"styleAttributes":{},
			"x":1600,
			"y":-1820,
			"width":280,
			"height":100
		}
	],
