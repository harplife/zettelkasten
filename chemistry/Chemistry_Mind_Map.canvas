			"fromNode":"2dd508951a616fb8",
			"fromSide":"bottom",
			"toNode":"4111497d03e10374",
			"toSide":"top"
		},
		{
			"id":"2c012931cdaf44c7",
			"styleAttributes":{},
			"toFloating":false,
			"fromNode":"728475b602b1d177",
			"fromSide":"bottom",
			"toNode":"b5851fe3bcbe8f34",
			"toSide":"top"
